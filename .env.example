# ── Django ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=azobatin_api.settings.development
SECRET_KEY=change-me-in-production
DEBUG=False
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/

# ── Base de données ─────────────────────────────────────────
DB_ENGINE=sqlite3
DB_NAME=mydatabase.sqlite3
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=localhost
DB_PORT=5432

# ── CORS ────────────────────────────────────────────────────
# Dev : CORS_ALLOW_ALL_ORIGINS=True (settings/development.py).
# Prod : définir les origines dans settings/production.py (pas de secrets ici).

# ── GetOurVoice / OTP ───────────────────────────────────────
# Doc : https://api-docs.getourvoice.com/otp
# Auth : Authorization: Bearer {GETOURVOICE_API_KEY}
# POST https://api.getourvoice.com/v1/otp/send  et  /v1/otp/verify
# Corps : send_to + (app_id XOR app_name, pas les deux) + channel=sms
GETOURVOICE_API_KEY=your-getourvoice-api-key
# GETOURVOICE_APP_ID=   # XOR : ne pas définir si APP_NAME est utilisé
GETOURVOICE_APP_NAME=Azɔbatɛn
# True = aucun SMS réel (l'app reçoit DEV_OTP_CODE).
# False = envoi réel via GetOurVoice.
OTP_SKIP_SMS=False
DEV_OTP_CODE=00000

# ── Email / SMTP ────────────────────────────────────────────
# Vérification d'email / activation. Ne jamais committer de vrais secrets.
# Exemples d'hôte : smtp.gmail.com, smtp.mailgun.org
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=exemple@email.com
EMAIL_HOST_PASSWORD=change-me-email-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Azobatin <noreply@azobatin.local>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ── FedaPay ─────────────────────────────────────────────────
# Sandbox (ne jamais committer de vraies clés)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SKIP_WEBHOOK_SIGNATURE=False
# Mode de paiement + balance de transfert (dashboard sandbox : « Momo Test »).
# L'API FedaPay attend le slug momo_test ; « Momo Test » est mappé automatiquement.
# Si GET /balances exige un ID numérique, coller l'id ici (ex. 42) à la place du libellé.
FEDAPAY_PAYOUT_MODE=Momo Test
FEDAPAY_TRANSFER_BALANCE=Momo Test

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Frontend ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
FRONTEND_ACTIVATION_SUCCESS_PATH=/activation-success
PUBLIC_API_BASE_URL=http://localhost:8000

# ── Render / production ──────────────────────────────────────
# DJANGO_SETTINGS_MODULE=azobatin_api.settings.production
# SECRET_KEY=<généré par Render ou openssl rand -hex 32>
# DEBUG=False
# ALLOWED_HOSTS=azobatin-api.onrender.com
# CSRF_TRUSTED_ORIGINS=https://azobatin-api.onrender.com
# DB_ENGINE=postgresql
# DB_NAME=azobatin
# DB_USER=azobatin
# DB_PASSWORD=<depuis Render Postgres>
# DB_HOST=<depuis Render Postgres>
# DB_PORT=5432
# PORT=8000
# WEB_CONCURRENCY=2
#
# Démarrage sûr (entrypoint.sh / entrypoint.render.sh) :
# RUN_SEED=0          # 1 = lance seeddata au boot (démo uniquement)
# ALLOW_FLUSH=0       # 1 = flush DB au boot (JAMAIS en prod permanente)
#
# Seed one-off recommandé :
#   python manage.py seeddata
#   python manage.py seeddata --reset
