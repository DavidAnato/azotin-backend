DJANGO_SETTINGS_MODULE=jobhub_api.settings.development
SECRET_KEY=change-me-in-production

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=exemple@email.com
EMAIL_HOST_PASSWORD=change-me-email-password
DEFAULT_FROM_EMAIL=Azotin <noreply@azotin.local>

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/

# GetOurVoice OTP (clé API uniquement — pas d'APP_ID)
GETOURVOICE_API_KEY=your-getourvoice-api-key
# Inscription dev : pas de SMS, code OTP fixe à saisir dans l'app
OTP_SKIP_SMS=True
DEV_OTP_CODE=00000

DB_NAME=mydatabase.sqlite3
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=sqlite3
DEBUG=False

REDIS_URL=redis://localhost:6379

# FedaPay Sandbox (ne jamais committer de vraies clés)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SKIP_WEBHOOK_SIGNATURE=False
# Mode de paiement + balance de transfert (dashboard sandbox : « Momo Test »).
# L'API FedaPay attend le slug momo_test ; « Momo Test » est mappé automatiquement.
# Si GET /balances exige un ID numérique, coller l'id ici (ex. 42) à la place du libellé.
FEDAPAY_PAYOUT_MODE=Momo Test
FEDAPAY_TRANSFER_BALANCE=Momo Test
PUBLIC_API_BASE_URL=http://localhost:8000

# ── Render / production ──────────────────────────────────────
# DJANGO_SETTINGS_MODULE=jobhub_api.settings.production
# SECRET_KEY=<généré par Render ou openssl rand -hex 32>
# DEBUG=False
# ALLOWED_HOSTS=azotin-api.onrender.com
# CSRF_TRUSTED_ORIGINS=https://azotin-api.onrender.com
# DB_ENGINE=postgresql
# DB_NAME=azotin
# DB_USER=azotin
# DB_PASSWORD=<depuis Render Postgres>
# DB_HOST=<depuis Render Postgres>
# DB_PORT=5432
# PORT=8000
# WEB_CONCURRENCY=2
#
# Démarrage sûr (entrypoint.sh / entrypoint.render.sh) :
# RUN_SEED=0          # 1 = lance seeddata au boot (démo uniquement)
# ALLOW_FLUSH=0       # 1 = flush DB au boot (JAMAIS en prod permanente)
#
# Seed one-off recommandé :
#   python manage.py seeddata
#   python manage.py seeddata --reset
